      "lines": [
        {
          "id": "line_ending_old_bow_high_trust",
          "title": "Final do arco antigo com confiança alta",
          "speakerId": "indio",
          "text": {
            "pt-BR": "Você recuperou meu arco antigo e mostrou respeito pela floresta. Obrigado por caminhar ao meu lado.",
            "en": "You recovered my old bow and respected the forest. Thank you for walking beside me."
          },
          "comment": "Origem: Ending_OldBowHighTrust.",
          "repeat": "once_per_session",
          "conditions": {
