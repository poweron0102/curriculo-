      "id": "seq_manual_conversation",
      "trigger": { "type": "manual_conversation" },
      "enabled": true,
      "lines": [
        {
          "id": "line_conversation_smalltalk",
          "title": "Conversa comum",
          "speakerId": "indio",
          "text": {
            "pt-BR": "Meu arco antigo ficou preso sob a grande pedra, mas a noite está acabando. Observe a floresta e escolha seu caminho.",
            "en": "My old bow is trapped beneath the great stone, but night is ending. Choose your path."
          },
          "comment": "Origem: Conversation_SmallTalk. Repetível a cada conversa manual.",
          "repeat": "every_trigger",
          "conditions": {
            "trust": { "minimum": null, "maximum": null },
            "itemStates": [],
            "milestones": []
          },
          "archived": false
        },
        {
          "id": "line_conversation_bow_recipe",
          "title": "Conversa sobre a receita",
          "speakerId": "indio",
          "text": {
            "pt-BR": "Agora confio em você. Una as duas pontas da fibra às extremidades do galho resistente; assim poderá construir um novo arco.",
            "en": "I trust you now. Tie both ends of the fiber to the sturdy branch to build a new bow."
          },
          "comment": "Origem: Conversation_BowRecipe. Desbloqueia a receita no runtime futuro.",
          "repeat": "once_per_session",
          "conditions": {
            "trust": { "minimum": 1, "maximum": null },
            "itemStates": [],
            "milestones": []
          },
          "archived": false
        }
      ]
