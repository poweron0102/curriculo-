      "lines": [
        {
          "id": "line_offering_sturdy_branch",
          "title": "Entrega do galho resistente",
          "speakerId": "indio",
          "text": {
            "pt-BR": "Este galho é firme e resistente. Talvez ele sirva como alavanca ou como parte de um novo arco.",
            "en": "This branch is sturdy. It may serve as a lever or as part of a new bow."
          },
          "comment": "Origem: Offering_SturdyBranch.",
          "repeat": "once_per_session",
          "conditions": {
