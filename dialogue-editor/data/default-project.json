      "lines": [
        {
          "id": "line_offering_plant_fiber",
          "title": "Entrega da fibra vegetal",
          "speakerId": "indio",
          "text": {
            "pt-BR": "A fibra é forte e flexível. Com um bom galho, ela pode virar a corda de um arco.",
            "en": "The fiber is strong and flexible. With a good branch, it can become a bowstring."
          },
          "comment": "Origem: Offering_PlantFiber.",
