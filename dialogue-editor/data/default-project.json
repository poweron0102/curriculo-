      "lines": [
        {
          "id": "line_ending_new_bow",
          "title": "Final do arco novo",
          "speakerId": "indio",
          "text": {
            "pt-BR": "Este novo arco nasceu das suas escolhas e daquilo que a floresta ofereceu. Você provou que merece minha confiança.",
            "en": "This new bow was born from your choices and what the forest offered. You earned my trust."
          },
          "comment": "Origem: Ending_NewBow.",
