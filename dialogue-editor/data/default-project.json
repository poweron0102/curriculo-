      "trigger": { "type": "first_item_delivered", "parameter": "animal_hide" },
      "enabled": true,
      "lines": [
        {
          "id": "line_offering_animal_hide",
          "title": "Entrega da pele de animal",
          "speakerId": "indio",
          "text": {
            "pt-BR": "Esta pele vai nos proteger do frio da madrugada. Você conquistou um pouco mais da minha confiança.",
            "en": "This hide will protect us from the cold dawn. You have earned more of my trust."
          },
          "comment": "Origem: Offering_AnimalHide.",
          "repeat": "once_per_session",
          "conditions": {
            "trust": { "minimum": null, "maximum": null },
            "itemStates": [],
