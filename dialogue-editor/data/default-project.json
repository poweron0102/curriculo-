        {
          "id": "line_offering_wild_berries",
          "title": "Entrega das frutas silvestres",
          "speakerId": "indio",
          "text": {
            "pt-BR": "Estas frutas vão nos alimentar. Obrigado por trazê-las até o acampamento.",
            "en": "These berries will feed us. Thank you for bringing them to camp."
