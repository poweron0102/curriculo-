      "enabled": true,
      "lines": [
        {
          "id": "line_offering_flint_piece",
          "title": "Entrega da pederneira",
          "speakerId": "indio",
          "text": {
            "pt-BR": "Bata as duas pedras perto da fogueira. Faíscas fortes podem reacender o fogo.",
            "en": "Strike both stones near the fire. Strong sparks may rekindle it."
          },
          "comment": "Origem: Offering_FlintPiece.",
