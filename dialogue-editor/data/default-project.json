          "id": "line_old_bow_recovered",
          "title": "Arco antigo recuperado",
          "speakerId": "indio",
          "text": {
            "pt-BR": "Você encontrou meu arco antigo. Traga-o até a esteira quando decidir encerrar sua busca.",
            "en": "You found my old bow. Bring it to the mat when you choose to end your search."
          },
