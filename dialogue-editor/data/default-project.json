    {
      "id": "seq_first_delivered_bird_feather",
      "trigger": { "type": "first_item_delivered", "parameter": "bird_feather" },
      "enabled": true,
      "lines": [
        {
          "id": "line_offering_bird_feather",
          "title": "Entrega da pena de pássaro",
          "speakerId": "indio",
          "text": {
            "pt-BR": "Esta pena me lembra que a floresta sempre deixa sinais para quem observa com cuidado.",
            "en": "This feather reminds me that the forest leaves signs for careful observers."
          },
          "comment": "Origem: Offering_BirdFeather.",
          "repeat": "once_per_session",
          "conditions": {
            "trust": { "minimum": null, "maximum": null },
