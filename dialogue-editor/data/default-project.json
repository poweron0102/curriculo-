      "lines": [
        {
          "id": "line_ending_old_bow_low_trust",
          "title": "Final do arco antigo com confiança baixa",
          "speakerId": "indio",
          "text": {
            "pt-BR": "Você trouxe o arco antigo, mas ainda conheço pouco suas intenções. Vou aceitá-lo com cautela.",
            "en": "You brought back the old bow, but I still know little of your intentions. I accept it cautiously."
          },
          "comment": "Origem: Ending_OldBowLowTrust.",
          "repeat": "once_per_session",
