    },
    {
      "id": "seq_first_delivered_common_branch",
      "trigger": { "type": "first_item_delivered", "parameter": "common_branch" },
      "enabled": true,
      "lines": [
        {
          "id": "line_offering_common_branch",
          "title": "Entrega do galho comum",
          "speakerId": "indio",
          "text": {
            "pt-BR": "Este galho é frágil. Pode ser útil na fogueira, mas quebraria sob o peso de uma pedra.",
            "en": "This branch is fragile. It may feed the fire, but it would break beneath a stone."
          },
          "comment": "Origem: Offering_CommonBranch.",
          "repeat": "once_per_session",
          "conditions": {
            "trust": { "minimum": null, "maximum": null },
            "itemStates": [],
            "milestones": []
